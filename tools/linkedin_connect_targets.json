{
  "_comment": "Default targeting criteria for tools/linkedin_connect.py. Explicit configurable data: who counts as a hiring person is defined HERE, never by hardcoded names in code. Scores add up; a candidate at or above min_score is invited. Tune with --targets pointing at your own copy.",
  "min_score": 4,
  "role_signals": [
    {"match": "talent acquisition", "weight": 4, "tag": "recruiter"},
    {"match": "recruiter", "weight": 4, "tag": "recruiter"},
    {"match": "recruitment", "weight": 4, "tag": "recruiter"},
    {"match": "hiring manager", "weight": 4, "tag": "hiring-manager"},
    {"match": "engineering manager", "weight": 3, "tag": "eng-leader"},
    {"match": "head of engineering", "weight": 3, "tag": "eng-leader"},
    {"match": "director of engineering", "weight": 3, "tag": "eng-leader"},
    {"match": "vp engineering", "weight": 3, "tag": "eng-leader"},
    {"match": "vice president engineering", "weight": 3, "tag": "eng-leader"},
    {"match": "cto", "weight": 3, "tag": "eng-leader"},
    {"match": "chief technology officer", "weight": 3, "tag": "eng-leader"},
    {"match": "staff engineer", "weight": 2, "tag": "senior-peer"},
    {"match": "principal engineer", "weight": 2, "tag": "senior-peer"},
    {"match": "engineering lead", "weight": 2, "tag": "eng-leader"},
    {"match": "tech lead", "weight": 2, "tag": "eng-leader"},
    {"match": "founder", "weight": 2, "tag": "founder"},
    {"match": "co-founder", "weight": 2, "tag": "founder"},
    {"match": "people operations", "weight": 2, "tag": "people-ops"},
    {"match": "hr manager", "weight": 2, "tag": "people-ops"}
  ],
  "domain_weight": 1,
  "domain_signals": [
    "genai",
    "generative ai",
    "llm",
    "large language model",
    "machine learning",
    "artificial intelligence",
    "deep learning",
    "ml engineer",
    "ai engineer",
    "data scientist",
    "rag",
    "agentic",
    "mlops",
    "nlp"
  ],
  "location_weight": 1,
  "location_allow": [
    "remote",
    "india",
    "delhi",
    "ncr",
    "noida",
    "gurgaon",
    "gurugram",
    "bengaluru",
    "bangalore",
    "mumbai",
    "hyderabad",
    "pune",
    "chennai"
  ],
  "discovery": {
    "_comment": "Seed keywords for the discover subcommand: role-title seeds combined with the domain_signals above and the location lens below. Listed order is priority order - execution stops at max_searches. No company-list mining, no pasted URLs in v1.",
    "max_searches": 3,
    "max_pages": 2,
    "max_profile_views": 5,
    "max_queued_per_day": 20,
    "search_min_delay": 8.0,
    "search_max_delay": 20.0,
    "role_seeds": [
      "recruiter",
      "hiring manager",
      "engineering manager",
      "talent acquisition",
      "head of engineering",
      "CTO"
    ],
    "locations": [
      "India",
      "Remote",
      "Delhi"
    ]
  }
}
